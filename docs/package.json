{
  "name": "yaoxiang-docs",
  "version": "1.0.0",
  "description": "YaoXiang 官方文档站点",
  "type": "module",
  "scripts": {
    "presync:syntax": "node ../scripts/sync-syntax.mjs",
    "sync:syntax": "node ../scripts/sync-syntax.mjs",
    "sync:syntax:watch": "node ../scripts/sync-syntax.mjs --watch",
    "docs:dev": "node ../scripts/sync-syntax.mjs && vitepress dev src",
    "docs:build": "node build.js",
    "docs:preview": "vitepress preview src",
    "lint:md": "markdownlint \"src/**/*.md\" --config .markdownlint.jsonc",
    "format:md": "prettier --write \"src/**/*.md\" --config .prettierrc.json",
    "format:md:check": "prettier --check \"src/**/*.md\" --config .prettierrc.json",
    "info": "vuepress info",
    "generate:rfc-index": "node scripts/generate-rfc-index.js",
    "migrate:rfc-metadata": "node scripts/migrate-rfc-metadata.js",
    "migrate:rfc-metadata:dry-run": "node scripts/migrate-rfc-metadata.js --dry-run",
    "trans:gen": "npx vpi gen",
    "trans:sync": "npx vpi sync"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.0",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.9",
    "@nolebase/vitepress-plugin-git-changelog": "^2.18.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@vueuse/core": "^14.4.0",
    "autoprefixer": "^10.5.4",
    "codemirror": "^6.0.0",
    "daisyui": "^5.7.22",
    "medium-zoom": "^1.1.0",
    "mermaid": "^11.17.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "vitepress": "^1.6.4",
    "vitepress-mermaid-renderer": "^1.2.0",
    "vitepress-plugin-back-to-top": "^1.0.1",
    "vitepress-plugin-group-icons": "^1.7.6",
    "vitepress-plugin-nprogress": "^0.1.1",
    "vitepress-plugin-tabs": "^0.9.1",
    "vitepress-sidebar": "^1.39.0",
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@chenxu233/vitepress-ai-i18n": "^1.1.0",
    "cd": "^0.3.3",
    "docs": "0.4.0"
  }
}