// src/std/tests/test_suite.yx
// 覆盖: RFC-036 §7 套件收集（test.suite 值化多测试模型）
// 验证:
//   - 文件内多测试：零参测试函数返回 Result(Void, String)，suite 逐个调用收集
//   - 全 Ok 静默通过，文件退出码 0
//   - 顶层测试函数以闭包形式入列（顶层函数名作值引用暂不支持——IR 层限制）
// 状态: ✅ 可运行

use std.list
use std.result
use std.string
use std.test

push_grows_len: () -> Result(Void, String) = () => {
    xs = [1]
    extended = list.push(xs, 2)
    test.assert_eq(list.len(extended), 2)
}

// 值语义（D9-A）：pop 返回**缩短后的新列表**，源被消费。
pop_shrinks_len: () -> Result(Void, String) = () => {
    xs = [1, 2]
    shorter = list.pop(xs)
    test.assert_eq(shorter.length, 1)
    test.assert_eq(shorter[0], 1)
}

parse_ok: () -> Result(Void, String) = () => {
    p = string.parse_int("42")
    v = result.unwrap(p)
    test.assert_eq(v, 42)
}

main: () -> Void = {
    test.suite([
        ("push_grows_len", () => push_grows_len()),
        ("pop_shrinks_len", () => pop_shrinks_len()),
        ("parse_ok", () => parse_ok()),
    ])
}

main()
