// src/std/tests/io_ops.yx
// 覆盖: std.io 模块（#117）— 文件 I/O 迁出 std.fs 后的剩余面（#104）
// 验证: format_fallback 类型前缀格式化；print/println 可调用（无返回值）
// 状态: ✅
// 注: read_line 依赖 stdin，无法在自动测试中覆盖（文档示例同此口径）。

use std.assert
use std.io
use std.string

main: () -> Void = {
    // format_fallback：带类型前缀的内部格式化
    s = io.format_fallback(42, "int")
    assert.assert(string.contains(s, "42"), "int value rendered")

    // print / println：无返回值，不参与值断言（此处仅保证可调用）
    io.println("io_ops: print/println smoke")
}

main()
