// src/std/tests/string_ops.yx
// 覆盖: std.string 模块（#117）— RFC-009 §2.8 只读自动借用
// 验证: 字符串操作复用（split/trim/upper/lower/replace/contains/...）+ parse 错误路径（Result err）
// 状态: ✅

use std.assert
use std.string
use std.list
use std.result

main: () -> Void = {
    s = "  Hello World  "

    // 只读操作可复用（&String 自动借用）
    assert.assert(string.trim(s) == "Hello World", "trim")
    assert.assert(string.upper("abc") == "ABC", "upper")
    assert.assert(string.lower("ABC") == "abc", "lower")
    assert.assert(string.replace("a-b-c", "-", "+") == "a+b+c", "replace")
    assert.assert(string.contains("hello", "ell"), "contains")
    assert.assert(string.starts_with("hello", "he"), "starts_with")
    assert.assert(string.ends_with("hello", "lo"), "ends_with")
    assert.assert(string.index_of("hello", "ll") == 2, "index_of")
    assert.assert(string.substring("hello", 1, 4) == "ell", "substring")
    assert.assert(string.len("hello") == 5, "len")
    assert.assert(!string.is_empty("x"), "not is_empty")
    assert.assert(string.is_empty(""), "is_empty")
    assert.assert(string.concat("a", "b") == "ab", "concat")
    assert.assert(string.repeat("ab", 3) == "ababab", "repeat")
    assert.assert(string.reverse("abc") == "cba", "reverse")

    // split 返回 Vec（值语义：下标读取会消费，故一次取一个）
    parts = string.split("x,y,z", ",")
    assert.assert(parts.length == 3, "split len 3")
    parts2 = string.split("x,y,z", ",")
    assert.assert(parts2[0] == "x", "split[0] == x")

    // chars 返回 List
    cs = string.chars("ab")
    assert.assert(cs.length == 2, "chars len 2")

    // 错误路径：parse 失败返回 Result err（优雅，不 panic）
    ok_r = string.parse_int("42")
    assert.assert(result.is_ok(ok_r), "parse_int ok")
    err_r = string.parse_int("not_a_number")
    assert.assert(result.is_err(err_r), "parse_int err on invalid")
    err_f = string.parse_float("xxx")
    assert.assert(result.is_err(err_f), "parse_float err on invalid")

    // char_code：Unicode 标量值口径（与 substring/chars 同域）
    assert.assert(string.char_code("A", 0) == 65, "char_code ASCII")
    assert.assert(string.char_code("é", 0) == 233, "char_code Latin-1")
    assert.assert(string.char_code("字", 0) == 23383, "char_code CJK")
    assert.assert(string.char_code("héllo", 1) == 233, "char_code index past multibyte")
    assert.assert(string.char_code("hi", 2) == -1, "char_code out of range → -1")
    assert.assert(string.char_code("", 0) == -1, "char_code on empty → -1")

    // #385 定案 D1/D2：len/index_of 也是 Unicode 标量值口径——
    // 与 substring/chars/char_code 同单位，多字节不再按字节劈开
    assert.assert(string.len("héllo") == 5, "len counts code points")
    assert.assert(string.len("中") == 1, "len CJK scalar")
    assert.assert(string.index_of("héllo", "é") == 1, "index_of scalar index")
    assert.assert(string.index_of("héllo", "lo") == 3, "index_of after multibyte")
    // 同域组合：index_of 的返回值可直接喂 substring/char_code/s[i]
    i = string.index_of("héllo", "é")
    assert.assert(string.substring("héllo", i, i + 1) == "é", "index_of feeds substring")
    assert.assert(string.char_code("héllo", i) == 233, "index_of feeds char_code")

    // from_char_code：合法码点 → 单字符字符串（Result ok）
    ok_c = string.from_char_code(65)
    assert.assert(result.is_ok(ok_c), "from_char_code ok")
    assert.assert(result.unwrap(ok_c) == "A", "from_char_code roundtrip ASCII")
    // 星面码点（U+1F600）直接产出合法 UTF-8，char_code 往返同值
    ok_e = string.from_char_code(128512)
    assert.assert(result.is_ok(ok_e), "from_char_code astral ok")
    assert.assert(string.char_code(result.unwrap(ok_e), 0) == 128512, "astral roundtrip")

    // from_char_code 错误路径：负数 / 代理区 / 超出上界 → E6012
    assert.assert(result.is_err(string.from_char_code(-1)), "negative codepoint err")
    assert.assert(result.is_err(string.from_char_code(0xD800)), "surrogate half err")
    assert.assert(result.is_err(string.from_char_code(0x110000)), "beyond max err")

    // format：占位符 + {{/}} 字面花括号转义（#402，与 Python 一致）
    assert.assert(string.format("Hello {}", "world") == "Hello world", "format basic")
    assert.assert(string.format("{0}+{1}={0}", 1, 2) == "1+2=1", "format indexed reuse")
    assert.assert(string.format("{{}}") == "{}", "format brace escape")
    assert.assert(string.format("a}}b") == "a}b", "format lone close brace literal")

    // format：Python 风格格式说明符（RFC-012 BNF）
    assert.assert(string.format("{0:.2f}", 3.14159) == "3.14", "format .2f")
    assert.assert(string.format("[{0:5d}]", -5) == "[   -5]", "format width align")
    assert.assert(string.format("{0:05d}", -5) == "-0005", "format zero flag")
    assert.assert(string.format("{0:x}|{0:#x}|{0:b}|{0:o}", 255) == "ff|0xff|11111111|377",
        "format radix presentations")
    assert.assert(string.format("{0:e}", 3.14159) == "3.141590e+00", "format scientific")
    assert.assert(string.format("{0:%}", 0.25) == "25.000000%", "format percent")
    assert.assert(string.format("{0:.3}", "hello") == "hel", "format string precision")
    assert.assert(string.format("{0:^7}", "hi") == "  hi   ", "format center align")
}

main()
