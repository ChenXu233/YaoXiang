// src/std/tests/os_ops.yx
// 覆盖: std.os 模块（#117）— 进程信息 / 文件句柄生命周期
// 验证: getcwd/args/get_env 进程信息 + open/write/close/seek/read 句柄操作
// 状态: ✅
// 注: 路径判定与目录操作已随 #104 迁往 std.fs（见 fs_ops.yx）。文件清理走
// fs.remove，句柄临时文件用 `__yx_` 前缀（与 io_ops.yx 同惯例）。

use std.assert
use std.fs
use std.os
use std.string

main: () -> Void = {
    // 工作目录：非空
    cwd = os.getcwd()
    assert.assert(string.len(cwd) > 0, "getcwd should be non-empty")

    // 进程参数：yaoxiang run <file> 至少有 argv[0]（非空）
    argv = os.args()
    assert.assert(string.len(argv) > 0, "args should contain at least the binary")

    // 环境变量：PATH 在主流平台必存在
    path = os.get_env("PATH")
    assert.assert(string.len(path) > 0, "PATH env var should exist")

    // 文件句柄生命周期（#337）：句柄按**引用**传递给 read/write/seek/tell/flush，
    // 不得因一次使用就失效。此前签名是 `(file: File)`（按值）→ 线性所有权
    // → `open → write → close` 直接报 E2014。
    hp = "__yx_os_handle_tmp.txt"
    w = os.open(hp, "w")
    n = os.write(w, "hello world")
    assert.assert(n == 11, "write returns byte count")
    os.close(w)              // close 也在引用语义下调用

    // 定位后读取（seek 存在的唯一理由）
    r = os.open(hp, "r")
    os.seek(r, 6)
    tail = os.read(r, 5)
    assert.assert(tail == "world", "seek then read: got " + tail)
    os.close(r)

    // 清理（#104 后文件删除在 std.fs）
    assert.assert(fs.remove(hp), "fs.remove handle tmp ok")
    assert.assert(!fs.exists(hp), "handle tmp gone after remove")
}

main()
