    Eq %3 <- %1, %2
    Load %4 <- string("tail_after_stmts(3) should be 7")
    Call %5 <- string("std.assert.assert") [%3, %4] (def=d2)
    Call %1 <- string("tail_if") [] (def=d4)
    Load %2 <- int(5)
    Eq %3 <- %1, %2
    Load %0 <- string("tail_if() should be 5 (if in tail position)")
    Call %5 <- string("std.assert.assert") [%3, %0] (def=d2)
    Load %0 <- int(1)
    Call %1 <- string("tail_match") [%0] (def=d5)
    Load %2 <- int(10)
    Eq %3 <- %1, %2
    Load %4 <- string("tail_match(1) should be 10")
    Call %5 <- string("std.assert.assert") [%3, %4] (def=d2)
    Load %0 <- int(9)
    Call %1 <- string("tail_match") [%0] (def=d5)
    Load %2 <- int(20)
    Eq %3 <- %1, %2
    Load %4 <- string("tail_match(9) should be 20")
    Call %5 <- string("std.assert.assert") [%3, %4] (def=d2)
    Load %4 <- int(1)
    Neg %0 <- %4
    Call %1 <- string("early_return") [%0] (def=d6)
    Load %2 <- int(0)
    Eq %3 <- %1, %2
    Load %6 <- string("early_return(-1) should be 0")
    Call %5 <- string("std.assert.assert") [%3, %6] (def=d2)
    Load %0 <- int(3)
    Call %1 <- string("early_return") [%0] (def=d6)
    Load %2 <- int(3)
    Eq %3 <- %1, %2
    Load %4 <- string("early_return(3) should be 3")
    Call %5 <- string("std.assert.assert") [%3, %4] (def=d2)
    Call %5 <- string("tail_assign") [] (def=d7)
    Call %5 <- string("if_no_else_is_void") [] (def=d8)
    Load %3 <- string("rfc010a block value ok")
    Call %5 <- string("std.io.println") [%3] (def=d0)
    Ret %5
  init (locals=0)
    Call %0 <- string("main") [] (def=_)
