module
  fn tail_expr_value(Int(64)) -> Int(64)
    slot[0] x : Int(64) @depth1
    locals_total=4
    Load %0 <- arg%0
    Load %1 <- %0
    Load %2 <- int(2)
    Mul %3 <- %1, %2
    Ret %3
  fn early_return(Int(64)) -> Int(64)
    slot[0] x : Int(64) @depth1
    locals_total=5
    Load %0 <- arg%0
    Load %1 <- %0
    Load %2 <- int(0)
    Lt %3 <- %1, %2
    JmpIfNot %3 -> instr(7)
    Load %4 <- int(0)
    Ret %4
    Load %3 <- %0
    Ret %3
  fn block_tail_in_function(Int(64)) -> Int(64)
    slot[0] x : Int(64) @depth1
    slot[1] a : Int(64) @depth1
    locals_total=5
    Load %0 <- arg%0
    Load %1 <- %0
    Load %2 <- int(1)
    Add %3 <- %1, %2
    Load %2 <- %3
    Load %4 <- int(2)
    Mul %1 <- %2, %4
    Ret %1
  fn explicit_and_tail(Int(64)) -> Int(64)
    slot[0] x : Int(64) @depth1
    locals_total=6
    Load %0 <- arg%0
    Load %1 <- %0
    Load %2 <- int(0)
    Lt %3 <- %1, %2
    JmpIfNot %3 -> instr(8)
    Load %4 <- int(1)
    Neg %5 <- %4
    Ret %5
    Load %1 <- %0
    Load %2 <- int(10)
    Mul %3 <- %1, %2
    Ret %3
  fn no_return_has_side_effect() -> Void
    locals_total=2
    Load %0 <- string("side effect ok")
    Call %1 <- string("std.io.println") [%0] (def=d0)
    Ret %1
