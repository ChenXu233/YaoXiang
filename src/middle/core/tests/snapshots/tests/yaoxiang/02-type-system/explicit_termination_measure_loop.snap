module
  fn loop(Int(64)) -> Int(64)
    slot[0] n : Int(64) @depth1
    slot[1] i : Int(64) @depth1
    slot[2] acc : Int(64) @depth1
    locals_total=8
    Load %0 <- arg%0
    Load %1 <- int(0)
    Load %2 <- void
    Load %3 <- %1
    Load %4 <- %0
    Lt %5 <- %3, %4
    JmpIfNot %5 -> instr(12)
    Load %6 <- %1
    Load %7 <- int(1)
    Add %1 <- %6, %7
    Load %2 <- %1
    Jmp -> instr(3)
    Load %5 <- %2
    Ret %5
    Ret %5
