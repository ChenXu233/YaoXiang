use crate::ast::{
    BinOp, Block, Expr, FStringSegment, Literal, MatchArm, Pattern, PlanId, Stmt, StmtKind,
};
use crate::util::span::{Position, Span};
use lalrpop_util::ErrorRecovery;
use super::{apply_suffix, parenthesized, PostfixSuffix, ProbeToken};

grammar<'err>(errors: &'err mut Vec<ErrorRecovery<Position, ProbeToken, String>>);

extern {
    type Location = Position;
    type Error = String;

    enum ProbeToken {
        "ident" => ProbeToken::Ident(<String>),
        "int" => ProbeToken::Int(<i128>),
        "text" => ProbeToken::Text(<String>),
        "main" => ProbeToken::KwMain,
        "if" => ProbeToken::KwIf,
        "=" => ProbeToken::Eq,
        "+" => ProbeToken::Plus,
        "(" => ProbeToken::LParen,
        "newline_lparen" => ProbeToken::NewlineLParen,
        ")" => ProbeToken::RParen,
        "{" => ProbeToken::LBrace,
        "}" => ProbeToken::RBrace,
        "," => ProbeToken::Comma,
        ";" => ProbeToken::Semicolon,
        "newline" => ProbeToken::Newline,
        "." => ProbeToken::Dot,
        "newline_dot" => ProbeToken::NewlineDot,
        "=>" => ProbeToken::FatArrow,
        "|" => ProbeToken::Pipe,
        "fstring_begin" => ProbeToken::FStringBegin,
        "fstring_end" => ProbeToken::FStringEnd,
        "interpolation_begin" => ProbeToken::InterpolationBegin,
        "interpolation_end" => ProbeToken::InterpolationEnd,
    }
}

pub File: Vec<StmtKind> = <stmts:StmtList> => stmts;

pub Block: Vec<StmtKind> =
    "main" "=" "{" <stmts:StmtList> "}" => stmts;

StmtList: Vec<StmtKind> = {
    #[precedence(level="1")]
    <stmt:Stmt> => vec![stmt],
    #[precedence(level="2")]
    #[assoc(side="left")]
    <mut statements:StmtList> StmtSeparator <stmt:Stmt> => {
        statements.push(stmt);
        statements
    },
};

StmtSeparator: () = {
    ";" => (),
    "newline" => (),
};

Stmt: StmtKind = {
    <target:AssignmentTarget> "=" <value:Expr> => {
        let span = target.span();
        StmtKind::Assign {
            target: Box::new(target),
            type_annotation: None,
            value: Some(Box::new(value)),
            is_mut: false,
            span,
        }
    },
    <expr:Expr> => StmtKind::Expr(Box::new(expr)),
    "newline_lparen" <start:@L> <name:"ident"> <end:@R> ")" =>
        StmtKind::Expr(Box::new(Expr::Var(name, Span::new(start, end)))),
    ! => {
        errors.push(<>);
        StmtKind::Error(Span::dummy())
    },
};

AssignmentTarget: Expr =
    <start:@L> <name:"ident"> <end:@R> => Expr::Var(name, Span::new(start, end));

pub Expr: Expr = {
    #[precedence(level="1")]
    Atom,
    #[precedence(level="4")]
    "(" <param_start:@L> <name:"ident"> <param_end:@R> ")"
    <arrow_start:@L> "=>" <arrow_end:@R> <body:Expr> =>
        parenthesized(
            name,
            Span::new(param_start, param_end),
            Some((Span::new(arrow_start, arrow_end), body)),
        ),
    #[precedence(level="3")]
    #[assoc(side="left")]
    <left:Expr> "+" <right:Expr> => {
        let span = Span::new(left.span().start, right.span().end);
        Expr::BinOp {
            op: BinOp::Add,
            left: Box::new(left),
            right: Box::new(right),
            span,
        }
    },
    #[precedence(level="2")]
    #[assoc(side="left")]
    <base:Expr> <suffix:PostfixSuffix> => apply_suffix(base, vec![suffix]),
};

PostfixSuffix: PostfixSuffix = {
    <start:@L> "(" <args:Args> ")" <end:@R> => PostfixSuffix::Call {
        args,
        span: Span::new(start, end),
    },
    "." <field_start:@L> <field:"ident"> <field_end:@R> => PostfixSuffix::Field {
        name: field,
        span: Span::new(field_start, field_end),
    },
    "newline_dot" <field_start:@L> <field:"ident"> <field_end:@R> => PostfixSuffix::Field {
        name: field,
        span: Span::new(field_start, field_end),
    },
};

Args: Vec<Expr> = {
    => vec![],
    <expr:Expr> => vec![expr],
};

Atom: Expr = {
    <start:@L> <name:"ident"> <end:@R> => Expr::Var(name, Span::new(start, end)),
    <start:@L> <value:"int"> <end:@R> => Expr::Lit(Literal::Int(value), Span::new(start, end)),
    FStringExpr,
};

pub FStringExpr: Expr =
    <start:@L> "fstring_begin" <segments:FStringPart*> "fstring_end" <end:@R> =>
        Expr::FString {
            segments,
            span: Span::new(start, end),
        };

FStringPart: FStringSegment = {
    <text:"text"> => FStringSegment::Text(text),
    "interpolation_begin" <expr:Expr> "interpolation_end" => FStringSegment::Interpolation {
        expr: Box::new(expr),
        format_spec: None,
    },
};

pub MatchArm: MatchArm =
    <pattern:Pattern> <guard:Guard?> "=>" <body:Expr> => {
        let pattern = match guard {
            Some(condition) => Pattern::Guard {
                pattern: Box::new(pattern),
                condition,
            },
            None => pattern,
        };
        let body_span = body.span();
        MatchArm {
            pattern,
            body: Block {
                stmts: vec![Stmt {
                    kind: StmtKind::Expr(Box::new(body)),
                    span: body_span,
                    plan_id: PlanId::UNPLANNED,
                }],
                span: body_span,
            },
            span: body_span,
        }
    };

Guard: Expr = "if" <expr:Expr> => expr;

pub Pattern: Pattern = {
    <first:PatternAtom> <rest:("|" <PatternAtom>)+> => {
        let mut patterns = vec![first];
        patterns.extend(rest);
        Pattern::Or(patterns)
    },
    PatternAtom,
};

PatternAtom: Pattern = {
    <value:"int"> => Pattern::Literal(Literal::Int(value)),
    <name:"ident"> => Pattern::Identifier(name),
    <name:"ident"> "(" <arg:Pattern> ")" => Pattern::Union {
        name: name.clone(),
        variant: name,
        pattern: Some(Box::new(arg)),
    },
};
