// fibonacci — 迭代斐波那契数列
// 测试: 整数运算和循环性能
// 从 BENCH_INPUT 环境变量读取输入规模，默认 90
//
// 注：默认值由 1000 下调至 90 —— fib(93) 起超出 i64 范围，而运行时的整数
// 溢出检查（#281）会将其报为 E6007 而非静默 wrap。基准测的是循环与算术的
// CPU 成本，不需要超出类型范围的值；90 是 i64 内不溢出的最大项。
// 基准输入由 bench.yaml 的 inputs 指定时，也应在该范围内取值。

use std.{io, os, string, result}

main = {
    n_str = os.get_env("BENCH_INPUT")
    n = if n_str == "" {
        90
    } else {
        parsed = string.parse_int(n_str)
        result.unwrap_or(parsed, 90)
    }

    mut total = 0
    for i in 0..10000 {
        mut a = 0
        mut b = 1
        mut j = 2
        while j <= n {
            mut temp = a + b
            a = b
            b = temp
            j = j + 1
        }
        total = b
    }
    io.println(total)
}