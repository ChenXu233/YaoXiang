// string_concat — 字符串拼接
// 测试: 字符串操作性能
// 从 BENCH_INPUT 环境变量读取循环次数，默认 500
//
// 口径（2026-10-15 统一，详见 bench.toml 头注）：三语言同为「累积拼接、每轮重建」。
// `s = s + "Hello"` 每轮重建整串（O(n²)）——python 对照版刻意不用 `+=`（CPython
// 有原地优化），rust 对照版刻意 `.clone()`（String + &str 会复用缓冲），
// 否则这张表量到的是复杂度差异而不是语言差异。

use std.{io, os, string, result}

main: () -> Void = {
    n_str = os.get_env("BENCH_INPUT")
    limit = if n_str == "" {
        500
    } else {
        parsed = string.parse_int(n_str)
        result.unwrap_or(parsed, 500)
    }

    mut s = ""
    mut i = 0
    while i < limit {
        s = s + "Hello"
        s = s + " "
        s = s + "World"
        s = s + "!"
        i = i + 1
    }
    io.println(s)
}

// 在入口语义下，顶层 main 绑定本身不构成入口——须显式调用。
// 缺少此调用会让基准静默空跑（实测读数约 61ms 恒定，与输入规模无关）。
main()
