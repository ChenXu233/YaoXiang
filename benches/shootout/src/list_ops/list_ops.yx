// list_ops — 列表操作
// 测试: 列表创建、遍历、过滤和映射
// 从 BENCH_INPUT 环境变量读取外层循环次数，默认 100
//
// 口径（2026-10-15 统一，详见 bench.toml 头注）：三个实现为同一算法、同一操作
// 序列；本侧用 `list.push`（摊还 O(1) 追加），与 python `append` / rust `push`
// 复杂度对齐。
// 历史读数（本机 input=100 实测）：原实现用 `nums = nums + [j]` 建表，每次复制
// 整个列表 → 整段 O(n²)，均值 1.25s（相对偏差 0.9%）；改用 push 后中位 488ms。
// 留着旧写法，这一栏的比值量的是复杂度而不是语言。

use std.{io, list, os, string, result}

double: (n: Int) -> Int = (n) => {
    return n * 2
}

main: () -> Void = {
    n_str = os.get_env("BENCH_INPUT")
    limit = if n_str == "" {
        100
    } else {
        parsed = string.parse_int(n_str)
        result.unwrap_or(parsed, 100)
    }

    mut total = 0
    mut i = 0
    while i < limit {
        mut nums = []
        mut j = 0
        while j < 1000 {
            nums = list.push(nums, j)
            j = j + 1
        }
        mut filtered = []
        for n in nums {
            if n % 2 == 0 {
                filtered = list.push(filtered, n)
            }
        }
        mut doubled = []
        for n in filtered {
            doubled = list.push(doubled, double(n))
        }
        total = total + doubled[0]
        i = i + 1
    }
    io.println(total)
}

// 在入口语义下，顶层 main 绑定本身不构成入口——须显式调用。
// 缺少此调用会让基准静默空跑（实测读数约 61ms 恒定，与输入规模无关）。
main()
