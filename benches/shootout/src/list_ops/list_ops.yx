// list_ops — 列表操作
// 测试: 列表创建、遍历、过滤和映射
// 从 BENCH_INPUT 环境变量读取外层循环次数，默认 100

use std.{io, os, string, result}

double: (n: Int) -> Int = (n) => {
    return n * 2
}

main = {
    n_str = os.get_env("BENCH_INPUT")
    limit = if n_str == "" {
        100
    } else {
        parsed = string.parse_int(n_str)
        result.unwrap_or(parsed, 100)
    }

    // 注：此处的过滤/映射用**索引遍历**而非 `for n in nums`——因为循环体内
    // 声明的列表迭代会报 E3004「Unsupported iterator type: <unknown>」
    // （循环体内的变量声明未进入 for 的可迭代类型解析，见 issue 记录）。
    // 用索引遍历可绕过该缺陷，且基准测的仍是列表读写与函数调用的 CPU 成本。
    mut total = 0
    mut i = 0
    while i < limit {
        mut nums = []
        mut j = 0
        while j < 1000 {
            nums = nums + [j]
            j = j + 1
        }
        mut filtered = []
        mut k = 0
        while k < 1000 {
            n = nums[k]
            if n % 2 == 0 {
                filtered = filtered + [n]
            }
            k = k + 1
        }
        mut doubled = []
        mut f = 0
        while f < 500 {
            doubled = doubled + [double(filtered[f])]
            f = f + 1
        }
        total = total + doubled[0]
        i = i + 1
    }
    io.println(total)
}