// 07-std/range_result_step0.yx
// 覆盖: stdlib.md §6.1 Range API Result 化（#316，#301 首个挂载点）
// 验证: 动态 step=0 在 iter/contains 返回 Err(Error)——
//   - `?` 沿调用栈传播到 Result 返回类型的函数（不再 E600x 硬崩）
//   - result.is_err / result.unwrap 显式分流（非 Result 上下文）
//   - 合法 step 的 Ok 路径零回归
// 状态: ✅ 可运行

use std.assert
use std.range
use std.result

// `?` 挂载点：step=0 时 Err 沿调用栈传播，消费方用 is_err 分流
first_of: (n: Int) -> Result(Any, Error) = {
    r = 1..10..n
    it = range.iter(r)?
    return result.ok(range.next(it))
}

contains_low: (n: Int, x: Int) -> Result(Bool, Error) = {
    r = 0..10..n
    return result.ok(range.contains(r, x)?)
}

main = {
    // 1. 合法 step：`?` 解包 Ok 路径
    a = first_of(2)
    assert.assert(result.is_ok(a), "step=2 → Ok")
    assert.assert(result.unwrap(a) == 1, "step=2 首元素 1")

    // 2. 动态 step=0：Err 经 `?` 传播（此前在 native 深处硬崩）
    b = first_of(0)
    assert.assert(result.is_err(b), "step=0 → Err 传播")
    c = first_of(3)
    assert.assert(result.unwrap(c) == 1, "step=3 首元素 1")

    // 3. contains 同款：合法 Ok / step=0 → Err
    d = contains_low(2, 4)
    assert.assert(result.unwrap(d), "step=2 对齐元素 in")
    e = contains_low(0, 4)
    assert.assert(result.is_err(e), "contains step=0 → Err")

    // 4. 非 Result 上下文：result.unwrap 显式分流
    it = result.unwrap(range.iter(1..3))
    assert.assert(range.next(it) == 1, "unwrap 后迭代器可用")
}
