// 07-std/time_ops.yx
// 覆盖: std.time 模块 — 时间获取（纯值，无借用）
// 验证: now/timestamp/timestamp_ms 返回正值 + DateTime 字段访问
// 状态: ✅

use std.assert
use std.time

main = {
    // 时间戳为正（Unix epoch 之后）
    assert.assert(time.now() > 0, "now > 0")
    assert.assert(time.timestamp() > 0, "timestamp > 0")
    assert.assert(time.timestamp_ms() > 0, "timestamp_ms > 0")

    // ms 精度不低于 s 精度
    assert.assert(time.timestamp_ms() >= time.timestamp(), "ms >= s")
}
