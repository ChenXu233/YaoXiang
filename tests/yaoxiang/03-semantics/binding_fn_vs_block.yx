// 03-semantics/binding_fn_vs_block.yx
// 覆盖: 类型由内容决定（B 方案）——`name = { ... }` 的函数 / 值分流
// 规范: spec §2.9.1 + RFC-010a 附录D 勘误（取代裁决 C 的「无注解 → 默认函数」）
// 状态: ✅ 可运行
//
// 判据是**注解**：
//   - `=>` lambda        → 函数（显式构造子）
//   - 注解是 Fn          → 函数
//   - 注解是非 Fn 类型   → 值（立即求值）
//   - 无注解             → 值（按内容推断）

use std.{assert, io}

// 注解是函数类型 → 函数
ann_fn: () -> Int = { 5 }

// 无注解 → **值**（内容推断：尾表达式 7），不是函数
no_ann_value = { 7 }

// 显式 lambda → 函数
lambda_fn = () => 9

// lambda 块体 → 函数（尾表达式给出值，不依赖注解）
lambda_block = () => {
    11
}

// 无注解 + return → 块的值仍是值（但要写在函数内：return 退出的是最近的函数边界）
fn_with_return: () -> Int = {
    v = { return 13 }   // return 穿出块，退出本函数
    v
}

direct_expr: (n: Int) -> Int = n + 1

// 空块 → Void 值（不是空字典，也不是函数）
empty = {}
is_void: () -> Void = {
    e: Void = empty     // 能赋给 Void 注解，证明确实是 Void
    e
}

main: () -> Void = {
    assert.assert(ann_fn() == 5, "ann_fn() should be 5")
    assert.assert(no_ann_value == 7, "no annotation => value 7")
    assert.assert(lambda_fn() == 9, "lambda_fn() should be 9")
    assert.assert(lambda_block() == 11, "lambda_block() should be 11")
    assert.assert(fn_with_return() == 13, "return penetrates the block, exits the function")
    assert.assert(direct_expr(1) == 2, "direct_expr(1) should be 2")

    // 非函数注解 → 块值（立即求值）
    x: Int = {
        y = 5
        y
    }
    assert.assert(x == 5, "annotated block value should be 5")

    z: String = { "block value" }
    assert.assert(z == "block value", "annotated block value should be string")

    w: Int = { 1 + 1 }
    assert.assert(w == 2, "annotated single-expr block should be 2")

    io.println("binding fn vs block ok")
}

main()
