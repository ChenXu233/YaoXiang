// 01-syntax/control-flow/top_level_for.yx
// 覆盖: 规范 syntax.md §3.9 for 语句 + §3.11 程序入口与顶层语句（Script 模式）+ #368
// 验证: 顶层（非函数体内）的 for 循环能完整遍历并正常退出，且循环体确实
//       执行了预期次数。循环出口的跳转目标落在初始化序列段尾，漏回填哨兵
//       会报 E6007（跳转偏移非法）——本用例钉住该回归。
// 状态: ✅ 可运行

use std.assert
use std.list

// 顶层循环：累加结果写入全局绑定，循环结束后断言其值
mut total = 0
for n in [10, 20, 30] {
    total = total + n
}

assert.assert(total == 60, "顶层 for 累加 10+20+30 == 60")
