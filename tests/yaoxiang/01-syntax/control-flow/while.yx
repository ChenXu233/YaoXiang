// 01-syntax/control-flow/while.yx
// 覆盖: 规范 §5.8 while 语句
// 验证: while 循环
// 状态: ✅ 可运行

use std.assert

main = {
    // 基本 while 循环
    mut i = 3
    while i > 0 {
        i = i - 1
    }
    assert.assert(i == 0, "while loop ran 3 times")

    // while 累加
    mut sum = 0
    mut n = 1
    while n <= 10 {
        sum = sum + n
        n = n + 1
    }
    assert.assert(sum == 55, "while sum 1..10 == 55")
}
