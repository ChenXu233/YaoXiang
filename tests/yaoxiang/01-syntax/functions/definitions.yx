// 01-syntax/functions/definitions.yx
// 覆盖: 规范 §6.3 函数定义
// 验证: 带类型标注的函数定义 (RFC-010 语法)
// 状态: ✅ 可运行

use std.assert

// 函数定义：参数名在签名中
add: (a: Int, b: Int) -> Int = (a, b) => {
    return a + b
}

// 单行函数体
inc: (x: Int) -> Int = (x) => {
    return x + 1
}

// 无参函数
greet: () -> String = () => {
    return "Hello"
}

main = {
    r1 = add(3, 4)
    assert.assert(r1 == 7, "add(3, 4) == 7")

    r2 = inc(41)
    assert.assert(r2 == 42, "inc(41) == 42")

    msg = greet()
    assert.assert(msg == "Hello", "greet() == Hello")
}
