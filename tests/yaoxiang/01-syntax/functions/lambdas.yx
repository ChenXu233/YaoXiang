// 01-syntax/functions/lambdas.yx
// 覆盖: 规范 §4.10 Lambda 表达式, §6.3 函数定义
// 验证: Lambda 定义和调用
// 状态: ✅ 可运行

use std.assert

main = {
    // 基本 Lambda
    double = (x) => x * 2
    assert.assert(double(21) == 42, "double(21) == 42")

    // 多参数 Lambda
    add = (a, b) => a + b
    assert.assert(add(3, 4) == 7, "add(3, 4) == 7")

    // Lambda 代码块
    max = (a, b) => {
        if a > b {
            return a
        } else {
            return b
        }
    }
    assert.assert(max(10, 20) == 20, "max(10, 20) == 20")
    assert.assert(max(30, 5) == 30, "max(30, 5) == 30")
}
