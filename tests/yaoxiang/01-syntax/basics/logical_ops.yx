// 01-syntax/basics/logical_ops.yx
// 覆盖: SPEC §2.2 / RFC-010 — and/or 短路 + ! 紧绑定（Zig 式）
// 验证: 真值表、优先级（! 高于 ==；and 高于 or）、短路（右侧副作用不执行）
// 状态: ✅

use std.assert
use std.{io, os}

main = {
    // and 真值表
    assert.assert(true and true, "and tt")
    assert.assert(!(true and false), "and tf")
    assert.assert(!(false and true), "and ft")
    assert.assert(!(false and false), "and ff")

    // or 真值表
    assert.assert(true or true, "or tt")
    assert.assert(true or false, "or tf")
    assert.assert(false or true, "or ft")
    assert.assert(!(false or false), "or ff")

    // 优先级：! 紧绑定（!a == b ≡ (!a) == b）；and 高于 or
    assert.assert(!(3 == 4), "!(3 == 4) ≡ true")
    assert.assert(!true == false, "!true == false —— ! 紧绑定到操作数")
    assert.assert(true or false and false, "true or (false and false) ≡ true")

    // 短路：and 左侧 false → 右侧不执行（文件不被创建）
    p = "/tmp/yaoxiang_shortcircuit_and.yx"
    assert.assert(!os.exists(p), "precondition: file absent")
    false and io.write_file(p, "side effect")
    assert.assert(!os.exists(p), "and short-circuit skipped rhs")

    // 短路：or 左侧 true → 右侧不执行
    true or io.write_file(p, "side effect")
    assert.assert(!os.exists(p), "or short-circuit skipped rhs")
}
