// 01-syntax/basics/logical_not.yx
// 覆盖: SPEC §2.2 逻辑非 `!` 运算符（Zig 式：and/or 关键字 + ! 符号，紧绑定）
// 验证: ! 对 Bool 取反、双重否定、紧绑定优先级（!a == b ≡ (!a) == b，只低于调用/成员）

use std.assert

main = {
    // 基本取反
    assert.assert(!true == false, "!true == false")
    assert.assert(!false == true, "!false == true")

    // 双重否定
    assert.assert(!!true == true, "!!true == true")
    assert.assert(!!false == false, "!!false == false")

    // 紧绑定（Zig 式）：! 高于 ==，!a == b ≡ (!a) == b
    assert.assert((!true) == false, "(!true) == false")
    assert.assert(!(true == false), "!(true == false) ≡ true")
    assert.assert(!(1 == 2), "!(1 == 2) ≡ true（显式括号取反比较结果）")
}
