// 01-syntax/basics/variables.yx
// 覆盖: 规范 §5.2 变量声明, §6.2 类型推导
// 验证: 变量声明 + 类型推导 + 可变性
// 状态: ✅ 可运行

use std.assert

main = {
    // 基本变量
    x = 42
    assert.assert(x == 42, "x == 42")

    // 类型推导
    name = "YaoXiang"
    assert.assert(name == "YaoXiang", "name == YaoXiang")

    // 布尔
    flag = true
    assert.assert(flag, "flag is true")

    // 浮点
    pi = 3.14
    assert.assert(true, "pi assigned")

    // 可变变量
    mut counter = 0
    counter = counter + 1
    assert.assert(counter == 1, "counter == 1")
}
