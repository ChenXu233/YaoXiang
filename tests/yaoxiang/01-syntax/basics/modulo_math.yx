// 01-syntax/basics/modulo_math.yx
// 覆盖: RFC-011b `%` 数学取模语义（符号随除数）
// 验证: 负操作数取模、浮点取模、正数行为不变
// 状态: ✅ 可运行

use std.assert

main: () -> Void = {
    // 正操作数：与旧截断余数行为一致
    assert.assert(10 % 3 == 1, "10 % 3 == 1")

    // 负被除数：结果符号跟随除数（数学取模）
    assert.assert(-7 % 3 == 2, "-7 % 3 == 2")
    assert.assert(7 % -3 == -2, "7 % -3 == -2")

    // 双负：除数为负，结果非正
    assert.assert(-7 % -3 == -1, "-7 % -3 == -1")

    // 浮点同语义
    assert.assert(7.5 % 2.0 == 1.5, "7.5 % 2.0 == 1.5")
    assert.assert(-7.5 % 2.0 == 0.5, "-7.5 % 2.0 == 0.5")

    // 编译期常量折叠路径与运行时路径结果一致（顶层绑定走折叠）
    folded: Int = -7 % 3
    assert.assert(folded == 2, "const-folded -7 % 3 == 2")

    // 除零仍是运行时错误（E6001），不静默
    assert.assert(5 % 5 == 0, "5 % 5 == 0")
}

main()
