// 04-concurrency/spawn_capture.yx
// 覆盖: RFC-024 §2.3 spawn 捕获外层变量（Move 值捕获）；#254 IR 捕获接线
// 验证: 多变量捕获真实值（t1+t2）；单变量/Struct 字段访问；嵌套表达式
// 状态: ✅ 可运行（#254 修复后）

use std.assert

Point: Type = { x: Int, y: Int }

main = {
    // 1. 多变量捕获（#254 复现：此前 t2 未捕获 → E6007）
    t1 = 1 + 1
    t2 = 2 + 2
    result = spawn {
        return t1 + t2
    }
    assert.assert(result == 6, "spawn 捕获双变量 t1+t2 == 6")

    // 2. 单变量捕获（RFC-024 §2.3 Move 值捕获）
    data = 42
    r1 = spawn {
        return data
    }
    assert.assert(r1 == 42, "spawn 捕获单变量 data == 42")

    // 3. Struct 字段访问经捕获（Embedded 同堆句柄）
    p = Point(3, 4)
    r2 = spawn {
        return p.x + p.y
    }
    assert.assert(r2 == 7, "spawn 捕获 Struct 字段 p.x+p.y == 7")

    // 4. 嵌套表达式捕获
    a = 10
    b = 20
    c = 30
    r3 = spawn {
        return (a + b) * c
    }
    assert.assert(r3 == 900, "spawn 嵌套表达式 (a+b)*c == 900")
}
