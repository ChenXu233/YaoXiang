// 04-concurrency/test_destructure.yx
// 覆盖: 元组解构赋值语法
// 验证: `a, b = (1, 2)` 和 `(a, b) = (1, 2)` 两种形式

use std.assert
main = {
    // Non-paren form: a, b = (1, 2)
    a, b = (1, 2)
    assert.assert(a == 1)
    assert.assert(b == 2);

    // Parenthesized form: (c, d) = (3, 4)
    (c, d) = (3, 4)
    assert.assert(c == 3)
    assert.assert(d == 4);

    // Three-element destructuring
    x, y, z = (10, 20, 30)
    assert.assert(x == 10)
    assert.assert(y == 20)
    assert.assert(z == 30);
}
