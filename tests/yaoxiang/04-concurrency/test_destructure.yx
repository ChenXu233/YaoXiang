// 04-concurrency/test_destructure.yx
// 覆盖: 元组解构赋值语法（SPEC syntax.md §3.2.1：只接受括号式）
// 验证: `(a, b) = (1, 2)` 括号式解构；裸形态 `a, b = e` 已取消（解析层 E0012）

use std.assert
main: () -> Void = {
    // Parenthesized form only: (a, b) = (1, 2)
    (a, b) = (1, 2)
    assert.assert(a == 1)
    assert.assert(b == 2);

    // Parenthesized form: (c, d) = (3, 4)
    (c, d) = (3, 4)
    assert.assert(c == 3)
    assert.assert(d == 4);

    // Three-element destructuring
    (x, y, z) = (10, 20, 30)
    assert.assert(x == 10)
    assert.assert(y == 20)
    assert.assert(z == 30);
}

main()
