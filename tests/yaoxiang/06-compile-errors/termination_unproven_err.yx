// 06-compile-errors/termination_unproven_err.yx
// 覆盖: RFC-027 §7 —— 度量变量带精化标注时进验证模式，循环终止性无法自动证明
// 验证: `i: UpTo(5)` 带精化标注 ⇒ 该循环进验证模式，须证终止。循环体使 `i`
//       递增（`i = i + 1`），任何递减度量都不成立，且无 `Terminates` 兜底
//       ⇒ E4021（编译器能力边界，非程序错误）。
// 状态: ❌ 应被编译期拒绝
//
// 注：与 bare_loop_needs_no_termination_proof.yx 成对——那里是**裸** `while`，
//     按 §7 不进验证模式、不生成义务（零诊断）；这里带精化标注，故必须证终止。
//     两者一起钉住 §7 的门控方向：漏掉门控会误报裸循环，门控过严会漏报本文件。
//
// E4021 与 E4022 的分工：
//   - E4021：**无法证明**终止（能力边界，不指向义务判伪）
//   - E4022：测度义务被**判伪**（有反例，且良基性已证）

// expect: compile-error E4021

UpTo: (n: Int) -> Type = { n > 0 }

main: () -> Void = {
    mut i: UpTo(5) = 5
    while i > 0 {
        i = i + 1
    }
}
