// 06-compile-errors/match_variant_pattern_err.yx
// RFC-010b 渐进支持——变体解构已落地（见 sum_type_match.yx），
// 本语料钉死：变体模式只能用于和类型 scrutinee——普通记录 Point
// 不是和类型（字段 x/y 是数据不是变体），Union 模式在类型层拒绝
// expect: compile-error E1002
// 验证: 变体解构要求和类型（「字段全为函数且返回自身」判定）
// 状态: ❌ 应编译失败

Point: Type = {
    x: Int,
    y: Int,
}

main: () -> Void = {
    p = Point(1, 2)
    v = match p {
        Point(x, y) => x
        _ => 0
    }
}
