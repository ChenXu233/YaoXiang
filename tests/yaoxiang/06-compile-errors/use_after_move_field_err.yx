// 06-compile-errors/use_after_move_field_err.yx
// Move 后经字段访问原变量（E2014）
// expect: compile-error E2014
// 覆盖: RFC-009 Dup 表 / SPEC type-system §11.2 — 含 &mut 字段（Linear）的 struct 不派生 Dup（#398）
// 验证: q = h 整体 Move 后，h.r 字段访问同样被拦截（E2014）
// 状态: ❌ 应编译失败

use std.io

// 同 move_after_use_err.yx：#398 后全可复制 struct 已 Dup，负例改用 &mut 字段
Holder: Type = { r: &mut Int }

main: () -> Void = {
    mut x = 1
    h = Holder(&mut x)
    q = h
    io.println(h.r)    // ❌ move 后字段访问
}
