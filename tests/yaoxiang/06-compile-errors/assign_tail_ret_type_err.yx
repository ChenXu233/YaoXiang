// expect: compile-error E1012
// （声明 -> Int，末位赋值语句值为 Void）
// 验证: 末位语句（非表达式）同样受返回类型约束，不得因「不是尾表达式」而跳过
//       （此前 check_body_tail_type 对非 Expr 末位早退，静默通过）
// 状态: ❌ 应编译失败

assign_tail: () -> Int = {
    x = 5
}

main: () -> Void = {
    y = assign_tail()
}
