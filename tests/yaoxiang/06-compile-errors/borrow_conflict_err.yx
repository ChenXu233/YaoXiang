// 06-compile-errors/borrow_conflict_err.yx
// 错误检测: 同一实参同时派生 &mut 与 & 令牌（SPEC type-system.md §12.5 alias_bad）
// 预期: 编译错误

use std.io

Point: Type = { x: Int, y: Int }

alias_both: (a: &mut Point, b: &Point) -> Void = {}

main = {
    p = Point(1, 2)
    alias_both(p, p)    // ❌ p 同时派生 &mut 和 & 令牌
    io.println("ALL TESTS PASSED")
}
