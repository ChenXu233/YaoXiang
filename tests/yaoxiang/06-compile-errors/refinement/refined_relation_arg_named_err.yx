// 06-compile-errors/refinement/refined_relation_arg_named_err.yx
// 覆盖: RFC-027 §2/§3.1/§3.3/§3.4 —— 命名实参的关系谓词调用点义务（#532）
// 验证: 命名实参按**形参名**入槽（与书写序无关）：`f(n = 7, N = 42)` 的约束
//       `Eq(n, N)` 代入后是 `Eq(7, 42)`，证明函数编译期执行为 false ⇒ E4018。
// 状态: ❌ 应被编译期拒绝
//
// 修复前该形态**静默通过并运行出 7**：调用点义务只按位置实参计数（命名实参调用
// 的位置实参数为 0 ⇒「全应用」闸门不成立 ⇒ 整条义务被跳过），与推断层/IR 层共用
// 的 `inference::arg_binding` 槽位绑定分叉。合法对照见
// 02-type-system/refinement/refined_relation_arg.yx 的命名实参调用。

// expect: compile-error E4018

Eq: (a: Int, b: Int) -> Type = { a == b }

f: (N: Int, n: Eq(n, N)) -> Int = { n }

main: () -> Void = {
    x: Int = f(n = 7, N = 42)
    print(x)
}
