// 06-compile-errors/refined_arg_invalid_err.yx
// 精化标注实参不可转换应报 E1092
// 错误检测: 证明函数精化标注使用不可转换实参（RFC-027 §语法 — 谓词应用实参必须是编译期常量形态）
// expect: compile-error E1092
// （#263 已修复：实参不可转换时报错，精化约束绝不静默丢弃）
//
// 注：函数体用**显式 lambda** `() => { ... }` 而非 Fn 注解块。
// 注解块（`main: () -> Void = { ... }`）存在既有缺口：体不经精化实参校验
// （见 decisions 文档 D4），写成本形式会让本用例静默通过而失去哨兵作用。

IsSmall: (x: Int) -> Type = { x < 100 }

main = () => {
    y: IsSmall(List(Int)) = 9999    // ❌ List(Int) 无法转换为编译期常量表达式
    y
}
