// 少传的实参落运行期以 Void 兜底填充炸 E6007，报错点位还在 std.test 内部。
// expect: compile-error E1010
// （assert_eq 签名 (a: Any, b: Any) -> Result(Void, String)，少传 1 实参即错）
// 验证: 命名空间调用缺参不再落入接收者启发式
// 状态: ❌ 应编译失败

use std.test

main: () -> Void = {
    r = test.assert_eq(1)
}
