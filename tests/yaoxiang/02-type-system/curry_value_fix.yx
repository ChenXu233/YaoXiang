// 02-type-system/curry_value_fix.yx
// 覆盖: RFC-011 §4.1 函数级 curry + SPEC §12.3 闭包不捕获、上下文柯里化固化（#294）
// 验证: 柯里化第二层引用外层运行期值参数 = 参数固化（非捕获），运行时值正确传递：
//   - make_adder(5)(3) == 8（外层参数 n 在创建点固化进闭包 env）
//   - gt(5) 作为 filter 谓词，逐元素调用时固化值 t=5 正确（此前 t 读到 Void/错绑）
// 状态: ✅

use std.assert
use std.list

gt: (t: Int) -> (x: Int) -> Bool = (x) => x > t
make_adder: (n: Int) -> (x: Int) -> Int = (x) => x + n

main = {
    add5 = make_adder(5)
    assert.assert(add5(3) == 8, "make_adder(5)(3) == 8")

    evens = list.filter([1, 6, 3, 8], gt(5))
    assert.assert(list.len(evens) == 2, "gt(5) 谓词 filter 保留 6,8")
}
