// 02-type-system/functions/fn_annotation_impl_fewer_params_ok.yx
// D54 / WBS 6.8.2c ①：t1 矩阵的**「通过」格**防回归夹具——实现少写形参不是错误：
//   类型层面按**声明**元数检查（f(1) 合法、f(1,2) 报 E1010），但实现头没写的位没有
//   运行期槽位，落在其上的实参在 IR 侧被丢弃、不参与体内计算（已登记为缺口）。
// 验证:
//   - f(1) == 1：实参被丢弃，函数返回自己的常量（与实参无关）
//   - 若将来把「实现少写形参」也判成错，本夹具转红
// 状态: ✅ 可运行

use std.assert

f: (a: Int) -> Int = () => 1

main: () -> Void = {
    assert.assert(f(1) == 1, "实现少写形参：缺席位由声明补名，元数按声明")
}

main()
