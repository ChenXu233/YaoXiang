// 02-type-system/generic_constructor.yx
// 验证: 泛型类型构造器单态化
// 状态: 待测试

use std.assert

List: (T: Type) -> Type = {
    data: Array(T),
    length: Int
}

main = {
    // 泛型构造器：List(1, 2, 3) 应自动推导 T=Int
    numbers: List(Int) = List(1, 2, 3)
    assert.assert(true, "generic constructor compiled and ran")
}
