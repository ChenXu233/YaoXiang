// 02-type-system/while_block_value.yx
// 覆盖: spec §2.9 / RFC-010a 规则① —— 所有 `{}` 块的值由尾表达式给出，**无例外**；
//       循环体也是 `{}` 块，故 `while` 的值 = 循环体块的值。
// 验证: 尾为表达式时循环取该表达式的类型与值（末次迭代的体值）——类型侧与运行期
//       双侧契约；尾为赋值语句时块值为 `Void`（该形态的负例见
//       06-compile-errors/while_assign_tail_is_void_err.yx）。
//       零迭代（循环体一次都没执行）不在本文件范围：那时没有「末次迭代的体值」，
//       循环值仍取 `Void`，属**已知残留**，契约由
//       02-type-system/while_zero_iteration_void_err.yx 承担。
// 状态: ✅ 可运行
//
// 历史（类型侧）：`while` 曾**恒定**定型为 `Void`，与规范「无例外」相违，也与 `for`
//   同取体块值不一致；`Void` 与任何非 Void 类型都不同一，该形态连编译都过不了。
//   该缺陷已按 spec §2.9 修掉（commit 9a4f3db1「while 取值按块语义」）——缺陷纯在类型侧。
// 运行期侧：#409（运行期 `while` 取值恒为 `Void`）已修复，故运行期契约同样由本文件
//   的显式 `main()` 调用钉住；零迭代取 `Void` 为已知残留（见上）。

use std.assert

main: () -> Void = {
    mut i: Int = 0
    last: Int = while i < 3 {
        i = i + 1
        i
    }
    assert.assert(i == 3, "循环应执行 3 次，i 累加到 3")
    assert.assert(last == 3, "循环的值应为末次迭代的尾表达式值 3")

    // 循环值为空时不应影响可变变量的最终状态
    mut j: Int = 0
    total: Int = while j < 4 {
        j = j + 1
        j * 10
    }
    assert.assert(j == 4, "第二个循环应执行 4 次")
    assert.assert(total == 40, "循环值应为末次迭代值 40，而非累加")
}

// 脚本模式下 `main` 不会隐式执行——必须显式调用，运行期契约才真正被 runner 执行。
main()
