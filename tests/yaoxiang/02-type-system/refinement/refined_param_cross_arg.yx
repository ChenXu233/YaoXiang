// 02-type-system/refinement/refined_param_cross_arg.yx
// 覆盖: RFC-027 §2/§3.1/§3.3 —— 形参约束引用**另一个**形参（`b: IsPositive(a)`）
// 验证: 约束属于 `a`，判定按**自由变量名**解析实参槽位：`a = 1` 满足
//       `a > 0` 时 `b = -5` 与本约束无关——位置、命名、乱序命名三种实参
//       形态都合法且运行结果正确。
// 状态: ✅ 可运行
//
// 负例见 06-compile-errors/refinement/refined_param_cross_arg_err.yx（`a = -5` 必须拒绝）。

use std.assert

IsPositive: (x: Int) -> Type = { x > 0 }

h: (a: Int, b: IsPositive(a)) -> Int = { a }

main: () -> Void = {
    x: Int = h(1, -5)
    assert.assert(x == 1, "h(1, -5) 应返回 1（约束属 a，b 的取值与本约束无关）")

    y: Int = h(a = 1, b = -5)
    assert.assert(y == 1, "命名实参同判：a = 1 满足 a > 0")

    z: Int = h(b = -5, a = 1)
    assert.assert(z == 1, "乱序命名实参按形参名入槽，判定不受书写序影响")
}

// T4 入口语义：Script 模式的 main **不会**隐式执行——必须显式调用，运行期断言才生效。
main()
