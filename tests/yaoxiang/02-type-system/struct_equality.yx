// 02-type-system/struct_equality.yx
// 覆盖: RFC-011b Equal 自动派生与显式覆盖
// 验证: 记录类型 == 逐字段比较、!= 取反、显式 equal 方法覆盖、contains 可用
// 状态: ✅ 可运行

use std.assert
use std.list

Point: Type = {
    x: Float,
    y: Float,
}

Vec3: Type = {
    x: Float,
    y: Float,
    z: Float,
    Equal(Vec3, Vec3),
}

// 带容差的自定义相等，覆盖逐字段自动派生
Vec3.equal: (self: &Vec3, other: &Vec3) -> Bool = {
    return self.x == other.x
}

Line: Type = {
    start: Point,
    end: Point,
}

main: () -> Void = {
    // 自动派生：无需任何实例化仪式
    a = Point(1.0, 2.0)
    b = Point(1.0, 2.0)
    assert.assert(a == b, "Point(1,2) == Point(1,2)")
    c = Point(1.0, 3.0)
    assert.assert(a != c, "Point(1,2) != Point(1,3)")
    assert.assert(a == a, "identity equal")

    // 嵌套记录递归比较
    l1 = Line(Point(0.0, 0.0), Point(1.0, 1.0))
    l2 = Line(Point(0.0, 0.0), Point(1.0, 1.0))
    assert.assert(l1 == l2, "nested struct equality")

    // 显式覆盖：y/z 被忽略，只比 x
    v1 = Vec3(1.0, 2.0, 3.0)
    v2 = Vec3(1.0, 9.9, 9.9)
    assert.assert(v1 == v2, "explicit equal override compares x only")

    // list.contains 依赖 ==，结构体列表开箱即用
    points = [Point(1.0, 2.0), Point(3.0, 4.0)]
    assert.assert(list.contains(points, Point(3.0, 4.0)), "contains finds struct")
    assert.assert(!list.contains(points, Point(9.0, 9.0)), "contains rejects missing")
}
