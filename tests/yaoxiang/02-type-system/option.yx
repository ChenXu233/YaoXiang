// 02-type-system/option.yx
// 覆盖: SPEC type-system.md §4.2 泛型类型定义（Option 记录类型）+ #251 P0-5（Option(T) 泛型绑定）
// 验证:
//   - weak.upgrade 返回 Option(Arc(T))，调用点泛型绑定
//   - 显式注解 Option(Arc(Int)) 与推断类型一致（mono.rs Arc/Weak lower，#251 P0-5）
//   - 类型不匹配负例（Option(Int) vs Option(Arc(Int))）由 06-compile-errors 覆盖
// 注: Option 变体消费（match some(v)）语法未落地，值无法断言（weak_ops.yx 同）；
// 编译期注解匹配即验证目标，println 仅确认运行成功
// 状态: ✅

use std.weak

main = {
    // ref 创建 Arc[Int]，weak.new 登记，upgrade 返回存活 Option(Arc(Int))
    p = ref 42
    w = weak.new(p)
    u = weak.upgrade(w)

    // 泛型签名绑定：显式注解必须与推断类型一致（编译期验证）
    u2: Option(Arc(Int)) = u
    println("option roundtrip ok")
}
