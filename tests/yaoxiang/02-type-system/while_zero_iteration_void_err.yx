// 02-type-system/while_zero_iteration_void_err.yx
// expect: runtime-error E6007
// 覆盖: spec §2.9 块值规则在**零迭代**维度的边界 + RFC-027 §6.9 循环形态 + issue #409
// 验证: `while` 作值的**主形态已在 #409 修复**（循环值 = 末次迭代的体块尾表达式值，
//       见同目录 while_block_value.yx）；零迭代是**已知残留**——循环体一次都没求值，
//       不存在「末次迭代的体值」，故循环值取 `Void`；类型侧判据 block_value_ty 给的是
//       体尾表达式的类型（静态近似，对「是否至少执行一次」无判定能力）。
//       本文件把该残留钉成契约：零迭代 ⇒ `Void` ⇒ 对该值作 `Int` 使用即**响亮失败**
//       （E6007 类型不匹配），而不是静默错值。
// 状态: ❌ 应运行失败（编译期无辜 + 运行期正确失败）
//
// 判定契约（RFC-036 §8 / tests/yaoxiang/TEST_STANDARDS.md 2.2）：
//   check 必须成功（编译期无辜）+ run 必须失败且输出含 [E6007]。
// 性质：入口函数显式调用——文件内定义的 `main` 在脚本模式下不会被隐式执行
//   （2026-10-04 复核：声明 main 而不调用会被 runner 记为 behavior PASS，等于没钉住
//   任何运行期行为）。
//
// 为何循环条件恒假：`i < 0` 初值为假 ⇒ 循环体零次执行 ⇒ 走上述残留路径。
// 若该残留被消除（例如类型侧对零迭代降级、或运行期产出类型默认值），本文件会因
// `check` 通过 + `run` 不再失败而 FAIL——届时请按新语义改动本文件，勿删断言。

use std.assert

main: () -> Void = {
    mut i: Int = 0
    // 零迭代：体绝不执行，故循环值不是 Int 而是 Void
    last: Int = while i < 0 {
        i = i + 1
        i
    }
    // 把 Void 当 Int 用 —— 契约点：此处必须报 E6007（Eq: Void vs Int(0)）
    assert.assert(last == 0, "零迭代 while 的值：残留形态，应在使用点响亮失败")
}

main()
