// 02-type-system/explicit_type_args.yx
// 覆盖: 语言规范 §4.3「Type 位接受类型实参」——显式类型实参调用
// 验证: `mk(Int)(5)` 类型实参层擦除后外层真实调用；与推断形式、部分应用并列
// 状态: ✅ 可运行
//
// 此前 `mk(Int)(5)` 静默返回 void：类型实参层被当作值实参传给 `Fn{[t], t}`，
// `t` 绑到 `MetaType`，外层拿不到 Int（D6.3）。
//
// 本用例同时守住**部分应用**不被误伤：`f(10)(5)` 里 `f(10)` 必须真的返回闭包，
// 不能因为「两层调用」就被当成类型实参层擦掉（否则 `f(10)(5)` 变成 `f(10, 5)`）。

use std.assert
use std.list

// 类型参数在形参与返回位都出现
mk: (A: Type) -> (x: A) -> A = x

// 两个类型参数
pick_first: (A: Type, B: Type) -> (x: A, y: B) -> A = x

// curry 两层值参数——用于守住部分应用
add2: (a: Int) -> (b: Int) -> Int = {
    a + b
}

main: () -> Void = {
    // 推断形式（基线）
    inferred = mk(5)
    assert.assert(inferred == 5, "mk(5) inferred == 5")

    // 显式类型实参：类型层擦除，外层真实调用
    explicit = mk(Int)(5)
    assert.assert(explicit == 5, "mk(Int)(5) == 5")

    // 显式类型实参与推断结果一致
    assert.assert(explicit == inferred, "explicit == inferred")

    // String 类型实参
    s = mk(String)("hi")
    assert.assert(s == "hi", "mk(String)(hi) == hi")

    // 多类型参数：前两个实参是类型，后两个是值
    p = pick_first(Int, String)(7, "ignored")
    assert.assert(p == 7, "pick_first(Int,String)(7,...) == 7")

    // 部分应用必须仍然返回可调用的闭包
    r = add2(10)(5)
    assert.assert(r == 15, "add2(10)(5) == 15 (partial application)")

    // 部分应用的中间结果本身可用
    add10 = add2(10)
    assert.assert(add10(1) == 11, "add10(1) == 11")
    assert.assert(add10(7) == 17, "add10(7) == 17")

    // 关键回归：显式类型实参触发单态化时，嵌入 std 的泛型函数必须存活。
    // 单态化会删掉「未特化的泛型」，而 `std.list` 系列本身就是泛型
    // （`list.yx` 里写为 `(A: Type) -> ...`），调用点又按原名（`std.list.push`）
    // 调用——一旦因 `mk(Int)` 触发 mono，它们会整批从函数表消失，
    // 运行时报「Native function not found: std.list.push」。
    v: Vec(Int) = [1, 2]
    pushed = list.push(item = 9, list = v)
    assert.assert(list.len(pushed) == 3, "std.list.* survives monomorphization")
    s2 = mk(String)("x")
    assert.assert(s2 == "x", "explicit type arg still works alongside std.list")
}

main()
