// 02-type-system/bare_loop_needs_no_termination_proof.yx
// 覆盖: RFC-027 §7 —— 终止检查的适用范围是精化类型（验证模式）
// 验证: **裸 `while` 不进验证模式**，不生成任何终止义务。
//       §7 原文：「裸 `while` 不进验证模式；度量变量带精化标注（如
//       `i: UpTo(n)`）时进验证模式，须证终止。」
//
//       本文件的两个循环都**无法**由四策略证明终止（推理能力边界），
//       但因变量无精化标注，按 §7 根本不该生成义务——修复前它们被误报
//       E4021。这是「编译器能力边界被当成程序错误」的误报，不是放宽检查。
//
//       `while flag` 形态尤其重要：策略 1（秩函数）正是为它设计的，但策略 1
//       当前恒空手（#377），故修复前 100% 误报。
// 状态: ✅ 可运行

use std.assert

main: () -> Void = {
    // 布尔标志循环：策略 1 的典型目标，但策略 1 不可用（#377）
    mut flag: Bool = true
    mut i: Int = 0
    while flag {
        i = i + 1
        if i > 3 { flag = false }
    }
    assert.assert(i == 4, "布尔标志循环应正常退出，i 累加到 4")

    // 双变量循环：i 增 j 减，bounded 但策略 3/4 不覆盖
    mut a: Int = 0
    mut b: Int = 10
    while a < b {
        a = a + 1
        b = b - 1
    }
    assert.assert(a == b or a == b + 1, "双变量循环应收敛（a 追上 b）")
}
