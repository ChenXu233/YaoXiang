// 02-type-system/string_index.yx
// 覆盖: #385 定案 D1/D3——String 下标 s[i] 与长度/定位的标量值口径
// 验证:
//   - s[i] 产出单字符 String（与 chars()/substring 同表示，单字符统一 String）
//   - len/index_of/substring/char_code/s[i] 全部 Unicode 标量值（码点）单位
//   - index_of 返回值与 s[i]/substring/char_code 同域，组合不错位
//   - s[i] 与字面量比较、拼串等 String 运算无缝
// 状态: ✅ 可运行

use std.assert
use std.string

main: () -> Void = {
    s = "héllo" // 5 个码点，UTF-8 下 6 字节

    // 标量值口径：len 数码点，不数字节（改口径前为 6）
    assert.assert(string.len(s) == 5, "len counts code points, not bytes")

    // s[i]：标量值下标，产出单字符 String
    assert.assert(s[0] == "h", "s[0] first char")
    assert.assert(s[1] == "é", "s[1] lands on scalar after multibyte lead byte")
    assert.assert(s[4] == "o", "s[4] last char")

    // index_of 返回标量值下标，与其他索引原语同域
    assert.assert(string.index_of(s, "é") == 1, "index_of scalar index")
    assert.assert(s[string.index_of(s, "é")] == "é", "index_of feeds s[i]")
    assert.assert(string.substring(s, 1, 3) == "él", "index_of feeds substring")
    assert.assert(string.char_code(s, 1) == 233, "char_code same index unit")
}

main()
