// 02-type-system/option_none_identity.yx
// 覆盖: RFC-010 和类型相等 —— 类型身份必须与构造路径无关
// 验证: `weak.upgrade` 产出的 Option 与构造器 `Option(T).none()` 产出的 Option
//       必须共享同一类型身份（intern("Option")），`==` 才为真。
//       此前 weak 侧用旧的 `TypeId::ENUM`(21)，构造器侧用 `TypeId::OPTION`(101)，
//       同一变体因身份不同静默判不等（false）。
// 状态: ✅ 可运行

use std.assert
use std.option
use std.weak

main: () -> Void = {
    // weak.upgrade 在强引用已释放时返回 none（std.weak 真实语义）
    p = ref 42
    w = weak.new(p)
    u = weak.upgrade(w)

    // 构造器路径产出的 none
    ctor_none = Option(Int).none()

    // 两条构造路径的类型身份必须一致 → 相等
    assert.assert(u == ctor_none, "weak 的 none 与构造器的 none 必须相等")
}

main()
