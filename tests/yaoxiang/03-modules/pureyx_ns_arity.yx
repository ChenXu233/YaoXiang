// 03-modules/pureyx_ns_arity.yx
// 覆盖: RFC-029 §6 std 模块与用户模块同质 + #387 嵌入路径命名空间调用严格计数
// 验证: 纯 yx 嵌入 std（std.test）命名空间调用精确 arity 放行且判定值正确
//       ——严格区间不误伤合法调用（对照 06-compile-errors/pureyx_ns_*_err.yx）
// 状态: ✅ 可运行

use std.test
use std.assert
use std.result

ok_eq = result.is_ok(test.assert_eq(2, 2))
assert.assert(ok_eq, "assert_eq(2, 2) 相等应返回 Ok")

ok_ne = result.is_ok(test.assert_ne(1, 3))
assert.assert(ok_ne, "assert_ne(1, 3) 不等应返回 Ok")

ok_true = result.is_ok(test.assert_true(true))
assert.assert(ok_true, "assert_true(true) 单参精确调用返回 Ok")

err_eq = result.is_err(test.assert_eq(1, 3))
assert.assert(err_eq, "assert_eq(1, 3) 不等应返回 Err")
