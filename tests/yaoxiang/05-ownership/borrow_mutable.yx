// 05-ownership/borrow_mutable.yx
// 验证: &mut T 令牌线性（不可复制）— 独占可变访问
// 状态: 待测试

use std.assert

Point: Type = { x: Int, y: Int }

Point.shift: (self: &mut Point, dx: Int, dy: Int) -> Void = {
    self.x = self.x + dx
    self.y = self.y + dy
}

main = {
    p = Point(1, 2)
    p.shift(3, 4)
    assert.assert(true, "shift completed — &mut T mutation works")
}
