// 05-ownership/chained_receiver_reuse.yx
// 链式 &mut 接收者顺序复用——无活跃借用时不冲突（写令牌瞬态，
// 顺序调用不互斥，SPEC §12.7 同款）；缺口1 落地后的正例对照
// 状态: ✅ 可运行

use std.assert

Point: Type = { x: Int, y: Int }
Point.shift: (self: &mut Point) -> Void = {
    self.x = self.x + 1
}
main = {
    p = Point(0, 0)
    p.shift()
    p.shift()
    assert.assert(p.x == 2, "sequential chained &mut receiver reuse")
}
